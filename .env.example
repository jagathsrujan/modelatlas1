# Supabase — browser-safe (anon) + server-only service role
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-placeholder
SUPABASE_SERVICE_ROLE_KEY=service-role-placeholder-never-NEXT_PUBLIC

# Agent — OpenRouter (server-only, stealth/ox-alpha). Supports multiple keys for 429 fallback:
# Single: OPENROUTER_API_KEY=sk-or-v1-...
# Multiple: OPENROUTER_API_KEY=sk-or-v1-aaa, OPENROUTER_API_KEY_2=sk-or-v1-bbb, or OPENROUTER_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb
OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEYS=
HF_TOKEN=
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions

# Official catalog adapters — server-only (live M3, fallback to curated_fixture if missing)
# https://artificialanalysis.ai/data-api/docs — Bearer, attribution required. Supports multiple keys like OpenRouter:
# ARTIFICIAL_ANALYSIS_API_KEY=aa_..., ARTIFICIAL_ANALYSIS_API_KEY_2=aa_..., or ARTIFICIAL_ANALYSIS_API_KEYS=aa_...,aa_...
ARTIFICIAL_ANALYSIS_API_KEY=
# ARTIFICIAL_ANALYSIS_API_KEY_2=
# ARTIFICIAL_ANALYSIS_API_KEYS=
# OpenRouter catalog: https://openrouter.ai/api/v1/models — optional Bearer for higher rate limit
# HF Inference Providers: https://huggingface.co/docs/inference-providers/en/index
# HF_TOKEN already above

# Marketplace adapters — server-only, public fetch where permitted (respect robots.txt)
# Amazon PA-API 5.0 — if keys present, uses PA-API, else public fetch with robots check
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
# Other retailers use public fetch only (no keys required): MD Computers, Vedant, E2E, Micro Center, JD.com

# Scout — server-only
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=

NEXT_PUBLIC_DEMO_FALLBACK=true
